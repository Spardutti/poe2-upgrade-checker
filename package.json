{
  "name": "poe2-upgrade-checker",
  "version": "0.5.0-beta.4",
  "description": "Free Path of Exile overlay (PoE2, and PoE1 in beta): press F2 on an item to see if it's really an upgrade for your build, judged by Path of Building's own calculations. Finds better gear on the trade site within your budget.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/trade.test.js test/rates.test.js test/listing.test.js test/pob.test.js test/pobverdict.test.js test/price.test.js test/games.test.js test/pobengine.test.js test/poe1-parser.test.js test/ninja.test.js test/keepsell.test.js test/workflow.test.js",
    "pob": "node tools/get-pob.js",
    "dist": "node tools/get-pob.js && npx electron-builder@25.1.8 --win nsis portable --publish never",
    "dist:linux": "node tools/get-pob.js && npx electron-builder@25.1.8 --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11"
  },
  "build": {
    "appId": "local.poe2.upgradechecker",
    "productName": "PoE Upgrade Checker",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "vendor/pob",
          "to": "pob",
          "filter": [
            "runtime/*.dll",
            "runtime/pobhost.exe"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PoE-Upgrade-Checker-Portable-${version}.exe"
    },
    "extraResources": [
      {
        "from": "vendor/pob",
        "to": "pob",
        "filter": [
          "src/**/*.lua",
          "src/**/*.json",
          "!src/Export/**",
          "runtime/lua/**",
          "LICENSE.md",
          "manifest.xml"
        ]
      },
      {
        "from": "vendor/pob1",
        "to": "pob1",
        "filter": [
          "src/**/*.lua",
          "src/**/*.json",
          "src/**/*.jsonc",
          "!src/Export/**",
          "runtime/lua/**",
          "LICENSE.md",
          "manifest.xml"
        ]
      },
      {
        "from": "pob/server.lua",
        "to": "pob/server.lua"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PoE-Upgrade-Checker-Setup-${version}.exe",
      "shortcutName": "PoE Upgrade Checker"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ets-public",
        "repo": "poe2-upgrade-checker",
        "releaseType": "release"
      }
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "extraResources": [
        {
          "from": "vendor/pob",
          "to": "pob",
          "filter": [
            "runtime/linux/**",
            "!runtime/linux/.version"
          ]
        }
      ],
      "artifactName": "PoE-Upgrade-Checker.AppImage",
      "synopsis": "Is this item an upgrade for your Path of Exile build?"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "author": {
    "name": "ets-public"
  },
  "homepage": "https://github.com/ets-public/poe2-upgrade-checker"
}
